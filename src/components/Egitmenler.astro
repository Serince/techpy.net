---
import ekip from '../data/ekip.json';
// Deterministik vitrin: dersi en çok olan 4 eğitmen (her derlemede aynı)
const havuz = [...ekip].sort((a: any, b: any) => (b.dersSayisi || 0) - (a.dersSayisi || 0) || a.ad.localeCompare(b.ad, 'tr')).slice(0, 4);
---
<div class="egitmen-grid not-content">
  {havuz.map((e: any) => (
    <div class="egitmen">
      {e.foto && <img src={e.foto} alt={e.ad} loading="lazy" />}
      <b>{e.ad}</b>
      <small>{e.rol}</small>
    </div>
  ))}
</div>
<p><a href="/hakkimizda/">Tüm ekip →</a></p>
